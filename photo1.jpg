    </span><span class="ͼg">radial-gradient</span><span>(</span><span class="ͼj">circle</span><span> </span><span class="ͼj">at</span><span> </span><span class="ͼj">15</span><span class="ͼg">%</span><span> </span><span class="ͼj">20</span><span class="ͼg">%</span><span>, </span><span class="ͼg">rgba</span><span>(</span><span class="ͼj">94</span><span>,</span><span class="ͼj">113</span><span>,</span><span class="ͼj">255</span><span>,</span><span class="ͼj">.22</span><span>), </span><span class="ͼj">transparent</span><span> </span><span class="ͼj">30</span><span class="ͼg">%</span><span>),
    </span><span class="ͼg">radial-gradient</span><span>(</span><span class="ͼj">circle</span><span> </span><span class="ͼj">at</span><span> </span><span class="ͼj">85</span><span class="ͼg">%</span><span> </span><span class="ͼj">75</span><span class="ͼg">%</span><span>, </span><span class="ͼg">rgba</span><span>(</span><span class="ͼj">182</span><span>,</span><span class="ͼj">91</span><span>,</span><span class="ͼj">255</span><span>,</span><span class="ͼj">.18</span><span>), </span><span class="ͼj">transparent</span><span> </span><span class="ͼj">30</span><span class="ͼg">%</span><span>);
}

.</span><span class="ͼl">stars</span><span>{
    position:</span><span class="ͼj">fixed</span><span>;
    inset:</span><span class="ͼj">0</span><span>;
    z-index:</span><span class="ͼj">-1</span><span>;
    pointer-events:</span><span class="ͼj">none</span><span>;
}

.</span><span class="ͼl">star</span><span>{
