</span><span class="ͼo">&lt;button</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"choice"</span><span> </span><span class="ͼn">onclick</span><span class="ͼg">=</span><span class="ͼk">"</span><span class="ͼm">yesAnswer</span><span>()</span><span class="ͼk">"</span><span class="ͼo">&gt;</span><span>
