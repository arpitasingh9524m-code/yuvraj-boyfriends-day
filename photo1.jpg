</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"icon"</span><span class="ͼo">&gt;</span><span>😂</span><span class="ͼo">&lt;/div&gt;</span><span>
