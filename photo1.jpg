    margin-bottom:</span><span class="ͼj">25</span><span class="ͼg">px</span><span>;
}

</span><span class="ͼo">h1</span><span>{
    font-family:</span><span class="ͼk">"DM Serif Display"</span><span>,</span><span class="ͼj">serif</span><span>;
    font-size:</span><span class="ͼg">clamp</span><span>(</span><span class="ͼj">75</span><span class="ͼg">px</span><span>,</span><span class="ͼj">15</span><span class="ͼg">vw</span><span>,</span><span class="ͼj">150</span><span class="ͼg">px</span><span>);
    font-weight:</span><span class="ͼj">400</span><span>;
    line-height:</span><span class="ͼj">.8</span><span>;

    background:</span><span class="ͼg">linear-gradient</span><span>(
        </span><span class="ͼj">100</span><span class="ͼg">deg</span><span>,
        </span><span class="ͼj">white</span><span>,
        #9caeff,
        #d29dff
    );

    -webkit-background-clip:</span><span class="ͼj">text</span><span>;
    color:</span><span class="ͼj">transparent</span><span>;
}

.</span><span class="ͼl">hero-text</span><span>{
    max-width:</span><span class="ͼj">650</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">35</span><span class="ͼg">px</span><span> </span><span class="ͼj">auto</span><span> </span><span class="ͼj">0</span><span>;
    color:#bfc3d8;
