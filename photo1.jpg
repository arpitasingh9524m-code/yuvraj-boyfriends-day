.</span><span class="ͼl">title</span><span>{
    font-family:</span><span class="ͼj">Georgia</span><span>,</span><span class="ͼj">serif</span><span>;
    font-size:</span><span class="ͼg">clamp</span><span>(</span><span class="ͼj">42</span><span class="ͼg">px</span><span>,</span><span class="ͼj">7</span><span class="ͼg">vw</span><span>,</span><span class="ͼj">70</span><span class="ͼg">px</span><span>);
    font-weight:</span><span class="ͼj">400</span><span>;
    margin-bottom:</span><span class="ͼj">20</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">subtitle</span><span>{
    color:#aeb3c8;
    line-height:</span><span class="ͼj">1.8</span><span>;
    max-width:</span><span class="ͼj">700</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">0</span><span> </span><span class="ͼj">auto</span><span> </span><span class="ͼj">45</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">card</span><span>{
    max-width:</span><span class="ͼj">850</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">auto</span><span>;
    padding:</span><span class="ͼj">42</span><span class="ͼg">px</span><span>;
    background:#ffffff0d;
    border:</span><span class="ͼj">1</span><span class="ͼg">px</span><span> </span><span class="ͼj">solid</span><span> #ffffff1a;
    border-radius:</span><span class="ͼj">30</span><span class="ͼg">px</span><span>;
    color:#d9dced;
    line-height:</span><span class="ͼj">2</span><span>;
    font-size:</span><span class="ͼj">17</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">card</span><span> </span><span class="ͼo">strong</span><span>{
    color:#aebaff;
}


</span><span class="ͼe">/* PHOTOS */</span><span>

.</span><span class="ͼl">photos</span><span>{
    margin-top:</span><span class="ͼj">55</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">photo-card</span><span>{
    max-width:</span><span class="ͼj">950</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">0</span><span> </span><span class="ͼj">auto</span><span> </span><span class="ͼj">75</span><span class="ͼg">px</span><span>;
    padding:</span><span class="ͼj">17</span><span class="ͼg">px</span><span>;

    display:</span><span class="ͼj">grid</span><span>;
    grid-template-columns:</span><span class="ͼj">1</span><span class="ͼg">fr</span><span> </span><span class="ͼj">1</span><span class="ͼg">fr</span><span>;
    gap:</span><span class="ͼj">30</span><span class="ͼg">px</span><span>;
    align-items:</span><span class="ͼj">center</span><span>;

    background:#ffffff0d;
    border:</span><span class="ͼj">1</span><span class="ͼg">px</span><span> </span><span class="ͼj">solid</span><span> #ffffff1a;
    border-radius:</span><span class="ͼj">30</span><span class="ͼg">px</span><span>;

    text-align:</span><span class="ͼj">left</span><span>;
}

.</span><span class="ͼl">photo-card</span><span>:</span><span class="ͼl">nth-child</span><span>(</span><span class="ͼj">even</span><span>) .</span><span class="ͼl">photo</span><span>{
    order:</span><span class="ͼj">2</span><span>;
}

.</span><span class="ͼl">photo</span><span>{
    overflow:</span><span class="ͼj">hidden</span><span>;
    border-radius:</span><span class="ͼj">22</span><span class="ͼg">px</span><span>;
    aspect-ratio:</span><span class="ͼj">4</span><span class="ͼg">/</span><span class="ͼj">5</span><span>;
    background:#111;
}

.</span><span class="ͼl">photo</span><span> </span><span class="ͼo">img</span><span>{
    width:</span><span class="ͼj">100</span><span class="ͼg">%</span><span>;
    height:</span><span class="ͼj">100</span><span class="ͼg">%</span><span>;
    object-fit:</span><span class="ͼj">cover</span><span>;
    display:</span><span class="ͼj">block</span><span>;
    transition:</span><span class="ͼj">.5</span><span class="ͼg">s</span><span>;
}

.</span><span class="ͼl">photo</span><span> </span><span class="ͼo">img</span><span>:</span><span class="ͼl">hover</span><span>{
    transform:</span><span class="ͼg">scale</span><span>(</span><span class="ͼj">1.05</span><span>);
}

.</span><span class="ͼl">caption</span><span>{
    padding:</span><span class="ͼj">25</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">number</span><span>{
    color:#8d9cff;
    font-size:</span><span class="ͼj">11</span><span class="ͼg">px</span><span>;
    letter-spacing:</span><span class="ͼj">3</span><span class="ͼg">px</span><span>;
    text-transform:</span><span class="ͼj">uppercase</span><span>;
}

.</span><span class="ͼl">caption</span><span> </span><span class="ͼo">h3</span><span>{
    font-family:</span><span class="ͼj">Georgia</span><span>,</span><span class="ͼj">serif</span><span>;
    font-size:</span><span class="ͼj">38</span><span class="ͼg">px</span><span>;
    font-weight:</span><span class="ͼj">400</span><span>;
    margin:</span><span class="ͼj">12</span><span class="ͼg">px</span><span> </span><span class="ͼj">0</span><span>;
}

.</span><span class="ͼl">caption</span><span> </span><span class="ͼo">p</span><span>{
    color:#aeb3c8;
    line-height:</span><span class="ͼj">1.8</span><span>;
}


</span><span class="ͼe">/* REASONS */</span><span>

.</span><span class="ͼl">reasons</span><span>{
    display:</span><span class="ͼj">grid</span><span>;
    grid-template-columns:</span><span class="ͼg">repeat</span><span>(</span><span class="ͼj">3</span><span>,</span><span class="ͼj">1</span><span class="ͼg">fr</span><span>);
    gap:</span><span class="ͼj">18</span><span class="ͼg">px</span><span>;
    margin-top:</span><span class="ͼj">45</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">reason</span><span>{
    padding:</span><span class="ͼj">28</span><span class="ͼg">px</span><span>;
    background:#ffffff0d;
    border:</span><span class="ͼj">1</span><span class="ͼg">px</span><span> </span><span class="ͼj">solid</span><span> #ffffff14;
    border-radius:</span><span class="ͼj">22</span><span class="ͼg">px</span><span>;
    text-align:</span><span class="ͼj">left</span><span>;
    transition:</span><span class="ͼj">.3</span><span class="ͼg">s</span><span>;
}

.</span><span class="ͼl">reason</span><span>:</span><span class="ͼl">hover</span><span>{
    transform:</span><span class="ͼg">translateY</span><span>(</span><span class="ͼj">-7</span><span class="ͼg">px</span><span>);
}

.</span><span class="ͼl">icon</span><span>{
    font-size:</span><span class="ͼj">34</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">reason</span><span> </span><span class="ͼo">h3</span><span>{
    margin:</span><span class="ͼj">12</span><span class="ͼg">px</span><span> </span><span class="ͼj">0</span><span> </span><span class="ͼj">8</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">reason</span><span> </span><span class="ͼo">p</span><span>{
    color:#aeb3c8;
    line-height:</span><span class="ͼj">1.7</span><span>;
    font-size:</span><span class="ͼj">14</span><span class="ͼg">px</span><span>;
}


</span><span class="ͼe">/* QUESTION */</span><span>

.</span><span class="ͼl">question-box</span><span>{
    max-width:</span><span class="ͼj">700</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">auto</span><span>;
    padding:</span><span class="ͼj">45</span><span class="ͼg">px</span><span>;
    background:#ffffff0d;
    border:</span><span class="ͼj">1</span><span class="ͼg">px</span><span> </span><span class="ͼj">solid</span><span> #ffffff1a;
    border-radius:</span><span class="ͼj">30</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">question</span><span>{
    font-family:</span><span class="ͼj">Georgia</span><span>,</span><span class="ͼj">serif</span><span>;
    font-size:</span><span class="ͼj">40</span><span class="ͼg">px</span><span>;
    margin-bottom:</span><span class="ͼj">30</span><span class="ͼg">px</span><span>;
}

.</span><span class="ͼl">buttons</span><span>{
    display:</span><span class="ͼj">flex</span><span>;
    justify-content:</span><span class="ͼj">center</span><span>;
    gap:</span><span class="ͼj">15</span><span class="ͼg">px</span><span>;
    flex-wrap:</span><span class="ͼj">wrap</span><span>;
}

.</span><span class="ͼl">choice</span><span>{
    background:</span><span class="ͼj">transparent</span><span>;
    border:</span><span class="ͼj">1</span><span class="ͼg">px</span><span> </span><span class="ͼj">solid</span><span> #6579e5;
}

.</span><span class="ͼl">choice</span><span>:</span><span class="ͼl">hover</span><span>{
    background:#6579e5;
}

</span><span class="ͼg">#</span><span class="ͼo">answer</span><span>{
    margin-top:</span><span class="ͼj">25</span><span class="ͼg">px</span><span>;
    color:#abbaff;
}


</span><span class="ͼe">/* GIFT */</span><span>

.</span><span class="ͼl">gift</span><span>{
    font-size:</span><span class="ͼj">90</span><span class="ͼg">px</span><span>;
    cursor:</span><span class="ͼj">pointer</span><span>;
    display:</span><span class="ͼj">inline-block</span><span>;
    transition:</span><span class="ͼj">.4</span><span class="ͼg">s</span><span>;
}

.</span><span class="ͼl">gift</span><span>:</span><span class="ͼl">hover</span><span>{
    transform:</span><span class="ͼg">scale</span><span>(</span><span class="ͼj">1.12</span><span>) </span><span class="ͼg">rotate</span><span>(</span><span class="ͼj">5</span><span class="ͼg">deg</span><span>);
}

.</span><span class="ͼl">secret</span><span>{
    display:</span><span class="ͼj">none</span><span>;
    max-width:</span><span class="ͼj">650</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">25</span><span class="ͼg">px</span><span> </span><span class="ͼj">auto</span><span> </span><span class="ͼj">0</span><span>;
    color:#c5c9dc;
    line-height:</span><span class="ͼj">1.9</span><span>;
}

.</span><span class="ͼl">secret</span><span> </span><span class="ͼo">strong</span><span>{
    color:#abbaff;
    font-size:</span><span class="ͼj">25</span><span class="ͼg">px</span><span>;
}


</span><span class="ͼe">/* FINAL */</span><span>

.</span><span class="ͼl">final</span><span> </span><span class="ͼo">h2</span><span>{
    font-family:</span><span class="ͼj">Georgia</span><span>,</span><span class="ͼj">serif</span><span>;
    font-size:</span><span class="ͼg">clamp</span><span>(</span><span class="ͼj">50</span><span class="ͼg">px</span><span>,</span><span class="ͼj">8</span><span class="ͼg">vw</span><span>,</span><span class="ͼj">90</span><span class="ͼg">px</span><span>);
    font-weight:</span><span class="ͼj">400</span><span>;
    line-height:</span><span class="ͼj">1</span><span>;

    background:</span><span class="ͼg">linear-gradient</span><span>(</span><span class="ͼj">100</span><span class="ͼg">deg</span><span>,#fff,#a8b5ff,#d6a6ff);
    -webkit-background-clip:</span><span class="ͼj">text</span><span>;
    color:</span><span class="ͼj">transparent</span><span>;
}

.</span><span class="ͼl">final</span><span> </span><span class="ͼo">p</span><span>{
    max-width:</span><span class="ͼj">700</span><span class="ͼg">px</span><span>;
    margin:</span><span class="ͼj">30</span><span class="ͼg">px</span><span> </span><span class="ͼj">auto</span><span>;
    color:#b8bdd0;
    line-height:</span><span class="ͼj">1.9</span><span>;
}


</span><span class="ͼe">/* HEARTS */</span><span>

.</span><span class="ͼl">heart</span><span>{
    position:</span><span class="ͼj">fixed</span><span>;
    bottom:</span><span class="ͼj">-40</span><span class="ͼg">px</span><span>;
    pointer-events:</span><span class="ͼj">none</span><span>;
    z-index:</span><span class="ͼj">50</span><span>;
    animation:</span><span class="ͼj">floatUp</span><span> </span><span class="ͼj">5</span><span class="ͼg">s</span><span> </span><span class="ͼj">linear</span><span> </span><span class="ͼj">forwards</span><span>;
}

</span><span class="ͼg">@keyframes</span><span> </span><span class="ͼo">floatUp</span><span>{

    </span><span class="ͼj">0</span><span class="ͼg">%</span><span>{
        opacity:</span><span class="ͼj">0</span><span>;
        transform:</span><span class="ͼg">translateY</span><span>(</span><span class="ͼj">0</span><span>);
    }

    </span><span class="ͼj">15</span><span class="ͼg">%</span><span>{
        opacity:</span><span class="ͼj">1</span><span>;
    }

    </span><span class="ͼj">100</span><span class="ͼg">%</span><span>{
        opacity:</span><span class="ͼj">0</span><span>;
        transform:</span><span class="ͼg">translateY</span><span>(</span><span class="ͼj">-110</span><span class="ͼg">vh</span><span>) </span><span class="ͼg">rotate</span><span>(</span><span class="ͼj">30</span><span class="ͼg">deg</span><span>);
    }

}


</span><span class="ͼe">/* MOBILE */</span><span>

</span><span class="ͼg">@media</span><span>(max-width:</span><span class="ͼj">700</span><span class="ͼg">px</span><span>){

    </span><span class="ͼo">section</span><span>{
        padding:</span><span class="ͼj">70</span><span class="ͼg">px</span><span> </span><span class="ͼj">15</span><span class="ͼg">px</span><span>;
    }

    .</span><span class="ͼl">card</span><span>{
        padding:</span><span class="ͼj">28</span><span class="ͼg">px</span><span> </span><span class="ͼj">20</span><span class="ͼg">px</span><span>;
    }

    .</span><span class="ͼl">photo-card</span><span>{
        grid-template-columns:</span><span class="ͼj">1</span><span class="ͼg">fr</span><span>;
        margin-bottom:</span><span class="ͼj">60</span><span class="ͼg">px</span><span>;
    }

    .</span><span class="ͼl">photo-card</span><span>:</span><span class="ͼl">nth-child</span><span>(</span><span class="ͼj">even</span><span>) .</span><span class="ͼl">photo</span><span>{
        order:</span><span class="ͼj">0</span><span>;
    }

    .</span><span class="ͼl">caption</span><span>{
        padding:</span><span class="ͼj">10</span><span class="ͼg">px</span><span> </span><span class="ͼj">5</span><span class="ͼg">px</span><span> </span><span class="ͼj">25</span><span class="ͼg">px</span><span>;
    }

    .</span><span class="ͼl">reasons</span><span>{
        grid-template-columns:</span><span class="ͼj">1</span><span class="ͼg">fr</span><span>;
    }

    .</span><span class="ͼl">question-box</span><span>{
        padding:</span><span class="ͼj">30</span><span class="ͼg">px</span><span> </span><span class="ͼj">20</span><span class="ͼg">px</span><span>;
    }

    .</span><span class="ͼl">question</span><span>{
        font-size:</span><span class="ͼj">32</span><span class="ͼg">px</span><span>;
    }

}

</span><span class="ͼo">&lt;/style&gt;</span><span>
</span><span class="ͼo">&lt;/head&gt;</span><span>


</span><span class="ͼo">&lt;body&gt;</span><span>


</span><span class="ͼe">&lt;!-- HERO --&gt;</span><span>

</span><span class="ͼo">&lt;section&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"container"</span><span class="ͼo">&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"small"</span><span class="ͼo">&gt;</span><span>
A little something for
</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;h1&gt;</span><span>
Yuvraj.
</span><span class="ͼo">&lt;/h1&gt;</span><span>

</span><span class="ͼo">&lt;p</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"hero-text"</span><span class="ͼo">&gt;</span><span>

Not a normal website.</span><span class="ͼo">&lt;br&gt;</span><span>
Not a normal message.</span><span class="ͼo">&lt;br&gt;</span><span>
Just a tiny digital world made especially for you.

</span><span class="ͼo">&lt;/p&gt;</span><span>

</span><span class="ͼo">&lt;button</span><span> </span><span class="ͼn">onclick</span><span class="ͼg">=</span><span class="ͼk">"</span><span class="ͼm">startStory</span><span>()</span><span class="ͼk">"</span><span class="ͼo">&gt;</span><span>
Open Your Surprise ✨
</span><span class="ͼo">&lt;/button&gt;</span><span>

</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;/section&gt;</span><span>



</span><span class="ͼe">&lt;!-- MESSAGE --&gt;</span><span>

</span><span class="ͼo">&lt;section</span><span> </span><span class="ͼn">id</span><span class="ͼg">=</span><span class="ͼk">"note"</span><span class="ͼo">&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"container"</span><span class="ͼo">&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"small"</span><span class="ͼo">&gt;</span><span>
01 / A note for you
</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;h2</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"title"</span><span class="ͼo">&gt;</span><span>
Some things are better written.
</span><span class="ͼo">&lt;/h2&gt;</span><span>

</span><span class="ͼo">&lt;p</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"subtitle"</span><span class="ͼo">&gt;</span><span>
So here's a tiny corner of the internet that belongs to you.
</span><span class="ͼo">&lt;/p&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"card"</span><span class="ͼo">&gt;</span><span>

If I had to explain what makes you special,
I'd probably need a much longer website.

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

Somewhere between the conversations,
the jokes, the random moments,
the little arguments and everything in between...

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

you became someone I genuinely care about.

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

So today isn't just about saying
</span><span class="ͼo">&lt;strong&gt;</span><span>Happy Boyfriend's Day.</span><span class="ͼo">&lt;/strong&gt;</span><span>

It's about celebrating the person behind the name —

</span><span class="ͼo">&lt;strong&gt;</span><span>Yuvraj.</span><span class="ͼo">&lt;/strong&gt;</span><span>

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

Your singing,
your eyes,
your way of looking at me,
and all those little things that make you...

</span><span class="ͼo">&lt;strong&gt;</span><span>you.</span><span class="ͼo">&lt;/strong&gt;</span><span>

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

I'm really glad you're part of my story. 💙

</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;/section&gt;</span><span>



</span><span class="ͼe">&lt;!-- PHOTOS --&gt;</span><span>

</span><span class="ͼo">&lt;section&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"container"</span><span class="ͼo">&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"small"</span><span class="ͼo">&gt;</span><span>
02 / Our little archive
</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;h2</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"title"</span><span class="ͼo">&gt;</span><span>
Four frames. One story.
</span><span class="ͼo">&lt;/h2&gt;</span><span>

</span><span class="ͼo">&lt;p</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"subtitle"</span><span class="ͼo">&gt;</span><span>
No fancy words needed for these.
The pictures already say enough.
</span><span class="ͼo">&lt;/p&gt;</span><span>


</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"photos"</span><span class="ͼo">&gt;</span><span>


</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"photo-card"</span><span class="ͼo">&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"photo"</span><span class="ͼo">&gt;</span><span>

