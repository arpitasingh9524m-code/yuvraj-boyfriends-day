\",\"value\":true},\"898390776\":{\"name\":\"898390776\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"2441895679\",\"gateValue\":\"true\",\"ruleID\":\"4v67pQCSWT6BwKtJ1THC5N:100.00:7\"}],\"version\":54,\"id_type\":\"userID\",\"value\":false},\"2066695685\":{\"name\":\"2066695685\",\"rule_id\":\"4G34LFp75GvYp8pMJs0wwN\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":false},\"3501259895\":{\"name\":\"3501259895\",\"rule_id\":\"23AhntfhC1Ux3M6NN1XoRF\",\"secondary_exposures\":[],\"version\":18,\"id_type\":\"userID\",\"value\":false},\"867377638\":{\"name\":\"867377638\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"2064454456\",\"gateValue\":\"false\",\"ruleID\":\"default\"},{\"gate\":\"3001618585\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":24,\"id_type\":\"userID\",\"value\":false}},\"dynamic_configs\":{\"1341269548\":{\"name\":\"1341269548\",\"rule_id\":\"default\",\"secondary_exposures\":[{\"gate\":\"295757309\",\"gateValue\":\"false\",\"ruleID\":\"6CYqzLNR69kOtn13xAfiry\"}],\"version\":19,\"id_type\":\"userID\",\"value\":{\"name\":\"google\",\"loginStrategy\":\"existing_user\",\"kind\":\"social\",\"enabled\":true,\"tempDisabled\":false},\"is_device_based\":false,\"passed\":false},\"1628125068\":{\"name\":\"1628125068\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":12,\"id_type\":\"userID\",\"value\":{\"allowed_payment_method_types\":[\"card\"],\"allow_invite_purchases\":true,\"blocked_card_issuer_countries\":[\"IN\"]},\"is_device_based\":false,\"passed\":false},\"4232437627\":{\"name\":\"4232437627\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":19,\"id_type\":\"userID\",\"value\":{\"asdk_app_697d413990c88191a2bf4799604f8f6c\":\"Turn on the ChatGPT App in [Salesforce](https://login.salesforce.com/lightning/setup/page/feature/sales-cloud-gpt/home?topic=SalesforceGo). View [documentation](https://help.salesforce.com/s/articleView?id=005237165\u0026type=1) for setup guidance.\",\"asdk_app_693ae33dd0f081918003ca256fe1126b\":\"Turn on the ChatGPT App in [Salesforce](https://login.salesforce.com/lightning/setup/page/feature/sales-cloud-gpt/home?topic=SalesforceGo). View [documentation](https://help.salesforce.com/s/articleView?id=005237165\u0026type=1) for setup guidance.\"},\"is_device_based\":false,\"passed\":false},\"2214612631\":{\"name\":\"2214612631\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"trigger_words\":[\"messi\",\"soccer\",\"FIFA\",\"World Cup\"]},\"is_device_based\":false,\"passed\":false},\"3228820201\":{\"name\":\"3228820201\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":18,\"id_type\":\"userID\",\"value\":{\"enabled\":false,\"position\":-1},\"is_device_based\":false,\"passed\":false},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\",\"enable_web_search\":false,\"user_prompt_key\":\"good_option\"},\"is_device_based\":false,\"passed\":false},\"3923090434\":{\"name\":\"3923090434\",\"rule_id\":\"3oWlxtnoHKmdKG6BLo9K8B:100.00:5-3oWlxrImfscJrgyGage6Pz\",\"secondary_exposures\":[],\"version\":30,\"id_type\":\"userID\",\"value\":{\"2026-06-22\":[\"Scan editors: You can now add scan editors to your configured repositories. Scan editors can update scans, including editing threat models, configuring notification rules, and managing scan sharing.\"],\"2026-05-04\":[\"Slack notifications: Get notified about new findings with the Codex Slack app. Go to the Scans page and select a scan you own to set up and customize alerts by severity, path, and keywords.\"],\"changelog_latest_date\":\"2026-06-22\"},\"is_device_based\":false,\"passed\":true},\"605519219\":{\"name\":\"605519219\",\"rule_id\":\"targetingGate\",\"secondary_exposures\":[{\"gate\":\"895740524\",\"gateValue\":\"false\",\"ruleID\":\"default\"}],\"version\":59,\"id_type\":\"userID\",\"value\":{},\"is_device_based\":false,\"is_experiment_active\":true,\"is_user_in_experiment\":false},\"762342243\":{\"name\":\"762342243\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":34,\"id_type\":\"userID\",\"value\":{\"default_rule_indicator\":true},\"is_device_based\":false,\"passed\":false},\"3774971069\":{\"name\":\"3774971069\",\"rule_id\":\"3wuW1nDxShKMpRhW6RD9w6-3wuW1lYvpZBi6rK0vJHwd4\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"