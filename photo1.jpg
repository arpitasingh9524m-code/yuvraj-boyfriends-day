</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"container final"</span><span class="ͼo">&gt;</span><span>

</span><span class="ͼo">&lt;div</span><span> </span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"small"</span><span class="ͼo">&gt;</span><span>
The last page
</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;h2&gt;</span><span>
Happy Boyfriend's Day,
</span><span class="ͼo">&lt;br&gt;</span><span>
Yuvraj. 💙
</span><span class="ͼo">&lt;/h2&gt;</span><span>

</span><span class="ͼo">&lt;p&gt;</span><span>

Four little frames can't hold every memory,
and one webpage can't hold every feeling.

But this is a tiny piece of our story —
made especially for you.

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

I'm really glad these pages have you in them.

</span><span class="ͼo">&lt;br&gt;&lt;br&gt;</span><span>

</span><span class="ͼo">&lt;strong&gt;</span><span>
Happy Boyfriend's Day, Yuvraj.
</span><span class="ͼo">&lt;/strong&gt;</span><span>

</span><span class="ͼo">&lt;/p&gt;</span><span>

</span><span class="ͼo">&lt;p</span><span> </span><span class="ͼn">style</span><span class="ͼg">=</span><span class="ͼk">"</span><span>font-size:</span><span class="ͼj">12</span><span class="ͼg">px</span><span>;letter-spacing:</span><span class="ͼj">3</span><span class="ͼg">px</span><span class="ͼk">"</span><span class="ͼo">&gt;</span><span>
MADE WITH 💙 FOR YUVRAJ
</span><span class="ͼo">&lt;/p&gt;</span><span>

</span><span class="ͼo">&lt;/div&gt;</span><span>

</span><span class="ͼo">&lt;/section&gt;</span><span>



</span><span class="ͼo">&lt;script&gt;</span><span>

</span><span class="ͼg">function</span><span> </span><span class="ͼm">startStory</span><span>(){

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"note"</span><span>)
    </span><span class="ͼg">.</span><span>scrollIntoView({
        behavior:</span><span class="ͼk">"smooth"</span><span>
    });

    </span><span class="ͼm">createHearts</span><span>();

}


</span><span class="ͼg">function</span><span> </span><span class="ͼm">yesAnswer</span><span>(){

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"answer"</span><span>)
    </span><span class="ͼg">.</span><span>innerHTML </span><span class="ͼg">=</span><span>
    </span><span class="ͼk">"Correct answer. 😌💙&lt;br&gt;&lt;br&gt;"</span><span> </span><span class="ͼg">+</span><span>
    </span><span class="ͼk">"Okay, you may continue scrolling now. 🫶"</span><span>;

    </span><span class="ͼm">createHearts</span><span>();

}


</span><span class="ͼg">function</span><span> </span><span class="ͼm">openGift</span><span>(){

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"gift"</span><span>)
    </span><span class="ͼg">.</span><span>innerHTML</span><span class="ͼg">=</span><span class="ͼk">"💙"</span><span>;

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"secret"</span><span>)
    </span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>display</span><span class="ͼg">=</span><span class="ͼk">"block"</span><span>;

    </span><span class="ͼm">createHearts</span><span>();

}


</span><span class="ͼg">function</span><span> </span><span class="ͼm">createHearts</span><span>(){

    </span><span class="ͼg">for</span><span>(</span><span class="ͼg">let</span><span> </span><span class="ͼm">i</span><span class="ͼg">=</span><span class="ͼj">0</span><span>;</span><span class="ͼm">i</span><span class="ͼg">&lt;</span><span class="ͼj">15</span><span>;</span><span class="ͼm">i</span><span class="ͼg">++</span><span>){

        </span><span class="ͼm">setTimeout</span><span>(</span><span class="ͼg">function</span><span>(){

            </span><span class="ͼg">const</span><span> </span><span class="ͼm">heart</span><span> </span><span class="ͼg">=</span><span>
            </span><span class="ͼm">document</span><span class="ͼg">.</span><span>createElement(</span><span class="ͼk">"div"</span><span>);

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>className</span><span class="ͼg">=</span><span class="ͼk">"heart"</span><span>;

            </span><span class="ͼg">const</span><span> </span><span class="ͼm">emojis</span><span class="ͼg">=</span><span>[
                </span><span class="ͼk">"💙"</span><span>,
                </span><span class="ͼk">"🤍"</span><span>,
                </span><span class="ͼk">"✨"</span><span>,
                </span><span class="ͼk">"🫶"</span><span>
            ];

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>innerHTML </span><span class="ͼg">=</span><span>
            </span><span class="ͼm">emojis</span><span>[
                </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>floor(
                    </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼm">emojis</span><span class="ͼg">.</span><span>length
                )
            ];

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>left </span><span class="ͼg">=</span><span>
            </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">100</span><span class="ͼg">+</span><span class="ͼk">"%"</span><span>;

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>fontSize </span><span class="ͼg">=</span><span>
            (</span><span class="ͼj">16</span><span class="ͼg">+</span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">25</span><span>)</span><span class="ͼg">+</span><span class="ͼk">"px"</span><span>;

            </span><span class="ͼm">document</span><span class="ͼg">.</span><span>body</span><span class="ͼg">.</span><span>appendChild(</span><span class="ͼm">heart</span><span>);

            </span><span class="ͼm">setTimeout</span><span>(</span><span class="ͼg">function</span><span>(){
                </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>remove();
            },</span><span class="ͼj">5500</span><span>);

        },</span><span class="ͼm">i</span><span class="ͼg">*</span><span class="ͼj">100</span><span>);

    }

}

</span><span class="ͼo">&lt;/script&gt;</span><span>

</span><span class="ͼo">&lt;/body&gt;</span><span>
</span><span class="ͼo">&lt;/html&gt;</span></code></pre></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></div></div></div></pre>
<h3 data-section-id="jvu4yc" dir="auto" data-start="12507" data-end="12524">After pasting</h3>
<p dir="auto" data-start="12526" data-end="12557"><strong data-start="12526" data-end="12557">Don't do anything else yet.</strong></p>
<p dir="auto" data-start="12559" data-end="12595">Just scroll to the bottom and click:</p>
<p dir="auto" data-start="12597" data-end="12615"><strong data-start="12597" data-end="12615">Commit changes</strong></p>
<p dir="auto" data-start="12617" data-end="12641">Then tell me <strong data-start="12630" data-end="12640"><code data-start="12632" data-end="12638">done</code></strong>.</p>
<p dir="auto" data-start="12643" data-end="12722" data-is-last-node="" data-is-only-node="">I'll give you <strong data-start="12657" data-end="12693">STEP 4 — uploading your 4 photos</strong>, with exactly what to click.</p></div></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div aria-label="Response actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none -mt-1 touch:w-[calc(100%+--spacing(3.5))] w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto cant-hover:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" role="group" tabindex="-1" style="mask-position: 0% 0%;"><button type="button" class="text-token-text-secondary hover:bg-token-surface-hover rounded-lg" aria-label="Copy response" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><div class="[&amp;_svg]:h-full [&amp;_svg]:w-full icon icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.1006 1.78516C16.793 1.78556 18.165 3.15808 18.165 4.85059V10.8838C18.1649 12.5762 16.7929 13.9478 15.1006 13.9482H13.998V15.0508C13.9976 16.7431 12.626 18.1151 10.9336 18.1152H4.90039C3.20789 18.1152 1.83537 16.7432 1.83496 15.0508V9.01758C1.83496 7.32482 3.20764 5.95215 4.90039 5.95215H6.00195V4.85059C6.00195 3.15783 7.37463 1.78516 9.06738 1.78516H15.1006ZM4.90039 7.28223