</span><span class="ͼe">&lt;!-- MUSIC BUTTON --&gt;</span><span>

</span><span class="ͼo">&lt;button</span><span>
</span><span class="ͼn">class</span><span class="ͼg">=</span><span class="ͼk">"music"</span><span>
</span><span class="ͼn">onclick</span><span class="ͼg">=</span><span class="ͼk">"</span><span class="ͼm">musicButton</span><span>()</span><span class="ͼk">"</span><span class="ͼo">&gt;</span><span>

♪

</span><span class="ͼo">&lt;/button&gt;</span><span>



</span><span class="ͼo">&lt;script&gt;</span><span>


</span><span class="ͼe">/* CREATE STARS */</span><span>

</span><span class="ͼg">const</span><span> </span><span class="ͼm">stars</span><span> </span><span class="ͼg">=</span><span>
</span><span class="ͼm">document</span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"stars"</span><span>);

</span><span class="ͼg">for</span><span>(</span><span class="ͼg">let</span><span> </span><span class="ͼm">i</span><span class="ͼg">=</span><span class="ͼj">0</span><span>;</span><span class="ͼm">i</span><span class="ͼg">&lt;</span><span class="ͼj">120</span><span>;</span><span class="ͼm">i</span><span class="ͼg">++</span><span>){

    </span><span class="ͼg">const</span><span> </span><span class="ͼm">star</span><span> </span><span class="ͼg">=</span><span>
    </span><span class="ͼm">document</span><span class="ͼg">.</span><span>createElement(</span><span class="ͼk">"div"</span><span>);

    </span><span class="ͼm">star</span><span class="ͼg">.</span><span>className</span><span class="ͼg">=</span><span class="ͼk">"star"</span><span>;

    </span><span class="ͼm">star</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>left </span><span class="ͼg">=</span><span>
    </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">100</span><span class="ͼg">+</span><span class="ͼk">"%"</span><span>;

    </span><span class="ͼm">star</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>top </span><span class="ͼg">=</span><span>
    </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">100</span><span class="ͼg">+</span><span class="ͼk">"%"</span><span>;

    </span><span class="ͼm">star</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>animationDelay </span><span class="ͼg">=</span><span>
    </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">2</span><span class="ͼg">+</span><span class="ͼk">"s"</span><span>;

    </span><span class="ͼm">stars</span><span class="ͼg">.</span><span>appendChild(</span><span class="ͼm">star</span><span>);
}



</span><span class="ͼe">/* START STORY */</span><span>

</span><span class="ͼg">function</span><span> </span><span class="ͼm">startStory</span><span>(){

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"message"</span><span>)
    </span><span class="ͼg">.</span><span>scrollIntoView({
        behavior:</span><span class="ͼk">"smooth"</span><span>
    });

    </span><span class="ͼm">createHearts</span><span>();

}



</span><span class="ͼe">/* QUESTION */</span><span>

</span><span class="ͼg">function</span><span> </span><span class="ͼm">yesAnswer</span><span>(){

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"answer"</span><span>)
    </span><span class="ͼg">.</span><span>innerHTML </span><span class="ͼg">=</span><span>
    </span><span class="ͼk">"Correct answer. 😌💙&lt;br&gt;&lt;br&gt;"</span><span> </span><span class="ͼg">+</span><span>
    </span><span class="ͼk">"Okay, you may continue scrolling now. 🫶"</span><span>;

    </span><span class="ͼm">createHearts</span><span>();

}



</span><span class="ͼe">/* GIFT */</span><span>

</span><span class="ͼg">function</span><span> </span><span class="ͼm">openGift</span><span>(){

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"gift"</span><span>)
    </span><span class="ͼg">.</span><span>innerHTML</span><span class="ͼg">=</span><span class="ͼk">"💙"</span><span>;

    </span><span class="ͼm">document</span><span>
    </span><span class="ͼg">.</span><span>getElementById(</span><span class="ͼk">"secret"</span><span>)
    </span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>display</span><span class="ͼg">=</span><span class="ͼk">"block"</span><span>;

    </span><span class="ͼm">createHearts</span><span>();

}



</span><span class="ͼe">/* FLOATING HEARTS */</span><span>

</span><span class="ͼg">function</span><span> </span><span class="ͼm">createHearts</span><span>(){

    </span><span class="ͼg">for</span><span>(</span><span class="ͼg">let</span><span> </span><span class="ͼm">i</span><span class="ͼg">=</span><span class="ͼj">0</span><span>;</span><span class="ͼm">i</span><span class="ͼg">&lt;</span><span class="ͼj">15</span><span>;</span><span class="ͼm">i</span><span class="ͼg">++</span><span>){

        </span><span class="ͼm">setTimeout</span><span>(</span><span class="ͼg">function</span><span>(){

            </span><span class="ͼg">const</span><span> </span><span class="ͼm">heart</span><span> </span><span class="ͼg">=</span><span>
            </span><span class="ͼm">document</span><span class="ͼg">.</span><span>createElement(</span><span class="ͼk">"div"</span><span>);

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>className</span><span class="ͼg">=</span><span class="ͼk">"heart"</span><span>;

            </span><span class="ͼg">const</span><span> </span><span class="ͼm">emojis</span><span class="ͼg">=</span><span>[
                </span><span class="ͼk">"💙"</span><span>,
                </span><span class="ͼk">"🤍"</span><span>,
                </span><span class="ͼk">"✨"</span><span>,
                </span><span class="ͼk">"🫶"</span><span>
            ];

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>innerHTML </span><span class="ͼg">=</span><span>
            </span><span class="ͼm">emojis</span><span>[
                </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>floor(
                    </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼm">emojis</span><span class="ͼg">.</span><span>length
                )
            ];

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>left </span><span class="ͼg">=</span><span>
            </span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">100</span><span class="ͼg">+</span><span class="ͼk">"%"</span><span>;

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>fontSize </span><span class="ͼg">=</span><span>
            (</span><span class="ͼj">16</span><span class="ͼg">+</span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">25</span><span>)</span><span class="ͼg">+</span><span class="ͼk">"px"</span><span>;

            </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>style</span><span class="ͼg">.</span><span>animationDuration </span><span class="ͼg">=</span><span>
            (</span><span class="ͼj">3</span><span class="ͼg">+</span><span class="ͼm">Math</span><span class="ͼg">.</span><span>random()</span><span class="ͼg">*</span><span class="ͼj">3</span><span>)</span><span class="ͼg">+</span><span class="ͼk">"s"</span><span>;

            </span><span class="ͼm">document</span><span class="ͼg">.</span><span>body</span><span class="ͼg">.</span><span>appendChild(</span><span class="ͼm">heart</span><span>);

            </span><span class="ͼm">setTimeout</span><span>(</span><span class="ͼg">function</span><span>(){

                </span><span class="ͼm">heart</span><span class="ͼg">.</span><span>remove();

            },</span><span class="ͼj">6500</span><span>);

        },</span><span class="ͼm">i</span><span class="ͼg">*</span><span class="ͼj">120</span><span>);

    }

}



</span><span class="ͼe">/* MUSIC */</span><span>

</span><span class="ͼg">function</span><span> </span><span class="ͼm">musicButton</span><span>(){

    </span><span class="ͼm">alert</span><span>(
    </span><span class="ͼk">"Want music on the website? 🎵</span><span class="ͼq">\n\n</span><span class="ͼk">"</span><span> </span><span class="ͼg">+</span><span>
    </span><span class="ͼk">"Put your MP3 file in the same folder "</span><span> </span><span class="ͼg">+</span><span>
    </span><span class="ͼk">"and I can add autoplay/play-pause music."</span><span>
    );

}

</span><span class="ͼo">&lt;/script&gt;</span><span>

</span><span class="ͼo">&lt;/body&gt;</span><span>
</span><span class="ͼo">&lt;/html&gt;</span></code></pre></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></div></div></div></pre>
<h3 data-section-id="5ulsq5" dir="auto" data-start="15866" data-end="15900">VERY IMPORTANT for your photos</h3>
<p dir="auto" data-start="15902" data-end="15955">Your GitHub repository should look exactly like this:</p>
<pre class="overflow-visible! px-0!" data-start="15957" data-end="16062"><div class="relative w-full mt-4 mb-1"><div class=""><div class="contents"><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-(--code-block-surface) corner-superellipse/1.1 overflow-clip rounded-3xl [--code-block-surface:var(--bg-elevated-secondary)] dark:[--code-block-surface:var(--composer-surface-primary)] lxnfua_clipPathFallback"><div class="pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1"><button type="button" class="flex gap-1 items-center select-none pointer-events-auto py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-6bbe06e6.svg#7fccfb" fill="currentColor"></use></svg></button></div><div class="relative"><div class="pe-11 pt-3" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼd ͼr"><div class="cm-scroller"><pre class="cm-content q9tKkq_readonly m-0"><code><span>your-repository/
│
├── index.html
├── photo1.jpg
├── photo2.jpg
├── photo3.jpg
└── photo4.jpg</span></code></pre></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></div></pre>
<p dir="auto" data-start="16064" data-end="16145"><strong data-start="16064" data-end="16110">Don't put the photos inside another folder</strong> unless you change the <code data-start="16133" data-end="16138">src</code> paths.</p>
<p dir="auto" data-start="16147" data-end="16209">The four photos you just sent should be renamed in this order:</p>
<ul data-start="16211" data-end="16337">
<li data-section-id="1xgyhtu" data-start="16211" data-end="16239">
<p dir="auto" data-start="16213" data-end="16239"><code data-start="16213" data-end="16225">photo1.jpg</code> → first photo</p>
</li>
<li data-section-id="y8ykob" data-start="16240" data-end="16269">
<p dir="auto" data-start="16242" data-end="16269"><code data-start="16242" data-end="16254">photo2.jpg</code> → second photo</p>
</li>
<li data-section-id="137k6xl" data-start="16270" data-end="16298">
<p dir="auto" data-start="16272" data-end="16298"><code data-start="16272" data-end="16284">photo3.jpg</code> → third photo</p>
</li>
<li data-section-id="sph7x2" data-start="16299" data-end="16337">
<p dir="auto" data-start="16301" data-end="16337"><code data-start="16301" data-end="16313">photo4.jpg</code> → black-and-white photo</p>
</li>
</ul>
<p dir="auto" data-start="16339" data-end="16386" data-is-last-node="" data-is-only-node="">Then GitHub Pages will load them automatically.</p></div></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div aria-label="Response actions" class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none -mt-1 touch:w-[calc(100%+--spacing(3.5))] w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto cant-hover:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" role="group" tabindex="-1" style="mask-position: 0% 0%;"><button type="button" class="text-token-text-secondary hover:bg-token-surface-hover rounded-lg" aria-label="Copy response" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><div class="[&amp;_svg]:h-full [&amp;_svg]:w-full icon icon"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" focusable="false" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M15.1006 1.78516C16.793 1.78556 18.165 3.15808 18.165 4.85059V10.8838C18.1649 12.5762 16.7929 13.9478 15.1006 13.9482H13.998V15.0508C13.9976 16.7431 12.626 18.1151 10.9336 18.1152H4.90039C3.20789 18.1152 1.83537 16.7432 1.83496 15.0508V9.01758C1.83496 7.32482 3.20764 5.95215 4.90039 5.95215H6.00195V4.85059C6.00195 3.15783 7.37463 1.78516 9.06738 1.78516H15.1006ZM4.90039 7.28223C3.94218 7.28223 3.16504 8.05936 3.16504 9.01758V15.0508C3.16544 16.0087 3.94243 