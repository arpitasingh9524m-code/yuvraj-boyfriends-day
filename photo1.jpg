    </span><span class="ͼj">transform</span><span> </span><span class="ͼj">.6</span><span class="ͼg">s</span><span>;
}

.</span><span class="ͼl">photo</span><span>:</span><span class="ͼl">hover</span><span> </span><span class="ͼo">img</span><span>{
