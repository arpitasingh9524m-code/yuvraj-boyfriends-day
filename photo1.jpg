</span><span class="ͼe">/* REASONS */</span><span>

.</span><span class="ͼl">reasons</span><span>{

    display:</span><span class="ͼj">grid</span><span>;

    grid-template-columns:
    </span><span class="ͼg">repeat</span><span>(</span><span class="ͼj">3</span><span>,</span><span class="ͼj">1</span><span class="ͼg">fr</span><span>);

