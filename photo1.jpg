    font-size:</span><span class="ͼg">clamp</span><span>(</span><span class="ͼj">42</span><span class="ͼg">px</span><span>,</span><span class="ͼj">7</span><span class="ͼg">vw</span><span>,</span><span class="ͼj">72</span><span class="ͼg">px</span><span>);
    font-weight:</span><span class="ͼj">400</span><span>;
}

