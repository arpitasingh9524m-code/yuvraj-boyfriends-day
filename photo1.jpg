    border:
    </span><span class="ͼj">1</span><span class="ͼg">px</span><span> </span><span class="ͼj">solid</span><span> </span><span class="ͼg">rgba</span><span>(</span><span class="ͼj">255</span><span>,</span><span class="ͼj">255</span><span>,</span><span class="ͼj">255</span><span>,</span><span class="ͼj">.1</span><span>);

    border-radius:</span><span class="ͼj">30</span><span class="ͼg">px</span><span>;

    box-shadow:
    </span><span class="ͼj">0</span><span> </span><span class="ͼj">25</span><span class="ͼg">px</span><span> </span><span class="ͼj">70</span><span class="ͼg">px</span><span> </span><span class="ͼg">rgba</span><span>(</span><span class="ͼj">0</span><span>,</span><span class="ͼj">0</span><span>,</span><span class="ͼj">0</span><span>,</span><span class="ͼj">.3</span><span>);
}

.</span><span class="ͼl">photo-card</span><span>:</span><span class="ͼl">nth-child</span><span>(</span><span class="ͼj">even</span><span>)
.</span><span class="ͼl">photo</span><span>{
