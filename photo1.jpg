    box-sizing:</span><span class="ͼj">border-box</span><span>;
}

</span><span class="ͼo">html</span><span>{
    scroll-behavior:</span><span class="ͼj">smooth</span><span>;
}

</span><span class="ͼo">body</span><span>{
    background:#070914;
