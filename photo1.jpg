    </span><span class="ͼj">0</span><span> </span><span class="ͼj">15</span><span class="ͼg">px</span><span> </span><span class="ͼj">45</span><span class="ͼg">px</span><span> </span><span class="ͼg">rgba</span><span>(</span><span class="ͼj">99</span><span>,</span><span class="ͼj">106</span><span>,</span><span class="ͼj">235</span><span>,</span><span class="ͼj">.35</span><span>);

    transition:</span><span class="ͼj">.3</span><span class="ͼg">s</span><span>;
}

.</span><span class="ͼl">start-btn</span><span>:</span><span class="ͼl">hover</span><span>{
    transform:</span><span class="ͼg">translateY</span><span>(</span><span class="ͼj">-4</span><span class="ͼg">px</span><span>);
}


</span><span class="ͼe">/* SECTIONS */</span><span>

</span><span class="ͼo">section</span><span>{
    min-height:</span><span class="ͼj">100</span><span class="ͼg">vh</span><span>;
    padding:</span><span class="ͼj">100</span><span class="ͼg">px</span><span> </span><span class="ͼj">20</span><span class="ͼg">px</span><span>;

