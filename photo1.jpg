    height:</span><span class="ͼj">2</span><span class="ͼg">px</span><span>;
    background:</span><span class="ͼj">white</span><span>;
    border-radius:</span><span class="ͼj">50</span><span class="ͼg">%</span><span>;
    animation:</span><span class="ͼj">twinkle</span><span> </span><span class="ͼj">2</span><span class="ͼg">s</span><span> </span><span class="ͼj">infinite</span><span> </span><span class="ͼj">alternate</span><span>;
}

</span><span class="ͼg">@keyframes</span><span> </span><span class="ͼo">twinkle</span><span>{
    </span><span class="ͼg">from</span><span>{
        opacity:</span><span class="ͼj">.2</span><span>;
    }
    </span><span class="ͼg">to</span><span>{
        opacity:</span><span class="ͼj">1</span><span>;
        transform:</span><span class="ͼg">scale</span><span>(</span><span class="ͼj">1.5</span><span>);
    }
}


</span><span class="ͼe">/* HERO */</span><span>

.</span><span class="ͼl">hero</span><span>{
